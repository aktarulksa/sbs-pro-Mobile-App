rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() <= 150 &&
             (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 30)) &&
             data.domain is string && data.domain.size() > 0 && data.domain.size() <= 100 &&
             (data.mainBalance is int || data.mainBalance is float) && data.mainBalance >= 0 &&
             (!('driveBalance' in data) || (data.driveBalance is int || data.driveBalance is float)) &&
             (!('bankBalance' in data) || (data.bankBalance is int || data.bankBalance is float)) &&
             data.pin is string && data.pin.size() >= 4 && data.pin.size() <= 8 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidTransactionRecord(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.type is string && data.type.size() > 0 && data.type.size() <= 50 &&
             data.recipient is string && data.recipient.size() > 0 && data.recipient.size() <= 100 &&
             data.operatorOrProvider is string && data.operatorOrProvider.size() > 0 && data.operatorOrProvider.size() <= 100 &&
             (data.amount is int || data.amount is float) && data.amount > 0 &&
             (data.commission is int || data.commission is float) && data.commission >= 0 &&
             data.status is string && data.status in ['SUCCESS', 'PENDING', 'FAILED'] &&
             data.trxId is string && data.trxId.size() > 0 && data.trxId.size() <= 100 &&
             (data.balanceAfter is int || data.balanceAfter is float) &&
             (!('reference' in data) || data.reference == null || (data.reference is string && data.reference.size() <= 200)) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow list: if false;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'email', 'domain', 'mainBalance', 'pin', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'phone', 'domain', 'mainBalance', 'driveBalance', 'bankBalance', 'pin', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'domain', 'phone', 'mainBalance', 'driveBalance', 'bankBalance', 'pin', 'updatedAt']);

      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(userId);

      match /transactions/{transactionId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId && isValidId(userId);

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(userId) &&
                         isValidId(transactionId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().id == transactionId &&
                         incoming().keys().hasAll(['id', 'userId', 'type', 'recipient', 'operatorOrProvider', 'amount', 'commission', 'status', 'trxId', 'balanceAfter', 'createdAt']) &&
                         incoming().keys().hasOnly(['id', 'userId', 'type', 'recipient', 'operatorOrProvider', 'amount', 'commission', 'status', 'trxId', 'balanceAfter', 'reference', 'createdAt']) &&
                         isValidTransactionRecord(incoming());

        // Transactions are immutable audit ledger
        allow update: if false;

        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      }
    }
  }
}
